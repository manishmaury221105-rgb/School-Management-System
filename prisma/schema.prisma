// Prisma Relational Database Schema for Professional School Management System
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum FeeStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NoticePriority {
  NORMAL
  HIGH
  URGENT
}

enum TargetAudience {
  ALL
  TEACHER
  STUDENT
  PARENT
  SPECIFIC_CLASS
}

// ----------------------------------------------------
// 1. AUTHENTICATION & USERS
// ----------------------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  name          String
  avatar        String?
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Role Specific Relations
  student       Student?
  teacher       Teacher?
  parent        Parent?
  noticesAuthored Notice[]
  leaveRequests   LeaveRequest[]
  notifications   Notification[]

  @@index([email, role])
}

// ----------------------------------------------------
// 2. ACADEMICS: CLASSES, SECTIONS, SESSIONS
// ----------------------------------------------------
model AcademicSession {
  id          String    @id @default(uuid())
  name        String    // e.g. "2026-2027"
  isCurrent   Boolean   @default(true)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classes     Class[]
}

model Class {
  id                String          @id @default(uuid())
  name              String          // e.g. "Class 10"
  gradeLevel        Int             // e.g. 10
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sections          Section[]
  subjects          Subject[]
  students          Student[]
  timetables        Timetable[]
  homeworks         Homework[]
  studyMaterials    StudyMaterial[]

  @@unique([name, academicSessionId])
}

model Section {
  id             String    @id @default(uuid())
  name           String    // e.g. "Section A"
  roomNo         String?
  maxCapacity    Int       @default(40)
  classId        String
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacherId String?
  classTeacher   Teacher?  @relation("ClassTeacherSection", fields: [classTeacherId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  students       Student[]
  timetables     Timetable[]
}

// ----------------------------------------------------
// 3. SUBJECTS
// ----------------------------------------------------
model Subject {
  id             String          @id @default(uuid())
  name           String          // e.g. "Advanced Mathematics"
  code           String          @unique // e.g. "MATH-101"
  maxMarks       Int             @default(100)
  passingMarks   Int             @default(33)
  classId        String
  class          Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId      String?
  teacher        Teacher?        @relation(fields: [teacherId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  timetables     Timetable[]
  homeworks      Homework[]
  studyMaterials StudyMaterial[]
  examMarks      ExamMark[]
}

// ----------------------------------------------------
// 4. STUDENT & PARENT PROFILES
// ----------------------------------------------------
model Student {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId        String        @unique // e.g. "STU-2026-1018"
  admissionNo      String        @unique // e.g. "ADM-2026-0941"
  rollNo           String
  dob              DateTime
  gender           String
  bloodGroup       String?
  address          String?
  admissionDate    DateTime      @default(now())
  previousSchool   String?
  house            String?
  status           StudentStatus @default(ACTIVE)

  classId          String
  class            Class         @relation(fields: [classId], references: [id])
  sectionId        String?
  section          Section?      @relation(fields: [sectionId], references: [id])
  parentId         String?
  parent           Parent?       @relation(fields: [parentId], references: [id])

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  attendanceLogs   Attendance[]
  homeworkSubmits  HomeworkSubmission[]
  feeInvoices      FeeInvoice[]
  examMarks        ExamMark[]
  libraryIssues    LibraryTransaction[]
  transportStopId  String?
  transportStop    TransportStop?       @relation(fields: [transportStopId], references: [id])
}

model Parent {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation   String?
  relationship String?   // "Father", "Mother", "Guardian"
  altPhone     String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  children     Student[]
}

// ----------------------------------------------------
// 5. TEACHER PROFILE
// ----------------------------------------------------
model Teacher {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherId        String    @unique // e.g. "TCH-2026-042"
  qualification    String
  experienceYears  Int       @default(0)
  joiningDate      DateTime  @default(now())
  salary           Decimal?  @db.Decimal(10, 2)
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignedSubjects Subject[]
  classTeacherOf   Section[] @relation("ClassTeacherSection")
  timetables       Timetable[]
  homeworkAssigned Homework[]
  studyMaterials   StudyMaterial[]
}

// ----------------------------------------------------
// 6. ATTENDANCE SYSTEM
// ----------------------------------------------------
model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  markedById  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date, status])
}

// ----------------------------------------------------
// 7. FEES & PAYMENTS
// ----------------------------------------------------
model FeeStructure {
  id          String       @id @default(uuid())
  name        String       // e.g. "Term 1 Tuition Fee"
  amount      Decimal      @db.Decimal(10, 2)
  dueDate     DateTime
  category    String       // "Tuition", "Transport", "Lab", "Sports"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  invoices    FeeInvoice[]
}

model FeeInvoice {
  id             String        @id @default(uuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String
  feeStructure   FeeStructure  @relation(fields: [feeStructureId], references: [id])
  totalAmount    Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  lateFee        Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  status         FeeStatus     @default(PENDING)
  dueDate        DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments       PaymentTransaction[]
}

model PaymentTransaction {
  id            String      @id @default(uuid())
  invoiceId     String
  invoice       FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountPaid    Decimal     @db.Decimal(10, 2)
  receiptNumber String      @unique // e.g. "REC-2026-8819"
  paymentMethod String      // "UPI", "Stripe", "Cash", "NetBanking"
  paymentDate   DateTime    @default(now())
  transactionId String?
  notes         String?
}

// ----------------------------------------------------
// 8. EXAMINATIONS & MARKS
// ----------------------------------------------------
model Exam {
  id          String     @id @default(uuid())
  title       String     // e.g. "Mid-Term Assessment 2026"
  term        String     // e.g. "Term 1"
  startDate   DateTime
  endDate     DateTime
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  examMarks   ExamMark[]
}

model ExamMark {
  id             String    @id @default(uuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id])
  marksObtained  Decimal   @db.Decimal(5, 2)
  maxMarks       Decimal   @default(100) @db.Decimal(5, 2)
  grade          String    // "A+", "A", "B+", "B", "C", "F"
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([examId, studentId, subjectId])
}

// ----------------------------------------------------
// 9. TIMETABLE
// ----------------------------------------------------
model Timetable {
  id          String    @id @default(uuid())
  dayOfWeek   String    // "Monday", "Tuesday", etc.
  periodNo    Int
  startTime   String    // "08:30"
  endTime     String    // "09:15"
  roomNo      String
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId   String?
  section     Section?  @relation(fields: [sectionId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
}

// ----------------------------------------------------
// 10. HOMEWORK & SUBMISSIONS
// ----------------------------------------------------
model Homework {
  id          String               @id @default(uuid())
  title       String
  description String
  assignedDate DateTime            @default(now())
  dueDate     DateTime
  attachment  String?
  classId     String
  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject              @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher              @relation(fields: [teacherId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id           String    @id @default(uuid())
  homeworkId   String
  homework     Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime  @default(now())
  fileUrl      String?
  notes        String?
  grade        String?   // "A+", "A", "B"
  feedback     String?
  status       String    @default("SUBMITTED") // "PENDING", "SUBMITTED", "GRADED"

  @@unique([homeworkId, studentId])
}

// ----------------------------------------------------
// 11. STUDY MATERIAL
// ----------------------------------------------------
model StudyMaterial {
  id          String    @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileType    String    // "PDF", "DOC", "VIDEO", "IMAGE"
  chapter     String?
  topic       String?
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  createdAt   DateTime  @default(now())
}

// ----------------------------------------------------
// 12. NOTICES, EVENTS & COMMUNICATIONS
// ----------------------------------------------------
model Notice {
  id          String         @id @default(uuid())
  title       String
  content     String
  category    String         // "Exams", "Sports", "Holiday", "PTM", "General"
  priority    NoticePriority @default(NORMAL)
  target      TargetAudience @default(ALL)
  targetClass String?
  attachment  String?
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  createdAt   DateTime       @default(now())
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String
  category    String    // "Sports", "Annual Day", "PTM", "Holiday"
  bannerImage String?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    // "FEE", "ATTENDANCE", "EXAM", "HOMEWORK", "GENERAL"
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// ----------------------------------------------------
// 13. LEAVE MANAGEMENT
// ----------------------------------------------------
model LeaveRequest {
  id             String      @id @default(uuid())
  applicantId    String
  applicant      User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  leaveType      String      // "Medical", "Casual", "Family", "Duty"
  fromDate       DateTime    @db.Date
  toDate         DateTime    @db.Date
  reason         String
  status         LeaveStatus @default(PENDING)
  adminRemarks   String?
  reviewedById   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ----------------------------------------------------
// 14. LIBRARY MANAGEMENT
// ----------------------------------------------------
model Book {
  id              String               @id @default(uuid())
  bookId          String               @unique // "BK-1029"
  title           String
  author          String
  isbn            String?              @unique
  category        String               // "Mathematics", "Science", "Literature", "History"
  quantity        Int                  @default(1)
  availableCopies Int                  @default(1)
  rackNumber      String?
  createdAt       DateTime             @default(now())

  transactions    LibraryTransaction[]
}

model LibraryTransaction {
  id         String    @id @default(uuid())
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id])
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fineAmount Decimal   @default(0) @db.Decimal(6, 2)
  status     String    @default("ISSUED") // "ISSUED", "RETURNED", "OVERDUE"
}

// ----------------------------------------------------
// 15. TRANSPORT MANAGEMENT
// ----------------------------------------------------
model TransportRoute {
  id          String          @id @default(uuid())
  routeName   String          // "North Zone Express Route 4"
  startPoint  String
  endPoint    String
  stops       TransportStop[]
  vehicles    Vehicle[]
  createdAt   DateTime        @default(now())
}

model TransportStop {
  id          String         @id @default(uuid())
  routeId     String
  route       TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName    String
  pickupTime  String         // "07:15 AM"
  dropTime    String         // "03:45 PM"
  fare        Decimal        @db.Decimal(8, 2)

  students    Student[]
}

model Vehicle {
  id            String         @id @default(uuid())
  vehicleNumber String         @unique // "CA-08-SX-9921"
  type          String         // "Bus", "Van"
  capacity      Int            @default(45)
  driverName    String
  driverPhone   String
  routeId       String?
  route         TransportRoute? @relation(fields: [routeId], references: [id])
  status        String         @default("ACTIVE")
}
