# ===================================================
# EDUSPHERE 360 - ENVIRONMENT CONFIGURATION
# ===================================================

# Server & App Environment
NODE_ENV=production
PORT=5173
NEXTAUTH_URL=http://localhost:5173
AUTH_SECRET=edusphere_super_secure_jwt_secret_key_32_bytes_long_min!

# PostgreSQL Database Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/edusphere_sms?schema=public"

# Cloudinary / Supabase Storage (For Student Photos, Study Materials, Attachments)
CLOUDINARY_CLOUD_NAME=edusphere-school
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_key

# Payment Gateways (Stripe & Razorpay)
# Razorpay (India / International)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Stripe (Global USD / EUR / GBP)
STRIPE_PUBLISHABLE_KEY=pk_test_YourPublishableKey
STRIPE_SECRET_KEY=sk_test_YourSecretKey
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email / SMTP Configuration (Notices & Fee Reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@edusphere.edu
SMTP_PASSWORD=your_app_password_here
SMTP_FROM="EduSphere 360 <notifications@edusphere.edu>"

# WhatsApp & SMS Gateway (Twilio / Gupshup)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_SMS_NUMBER=+12025550143
